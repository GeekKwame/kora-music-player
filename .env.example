# Django
SECRET_KEY=replace-with-a-long-random-production-secret
DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1 [::1]

# PostgreSQL local development (used when DATABASE_URL is not set)
DB_NAME=kora_db
DB_USER=kora_user
DB_PASSWORD=replace-this-local-password
DB_HOST=localhost
DB_PORT=5435

# PostgreSQL deployment (takes precedence over individual DB_* values)
# DATABASE_URL=postgresql://user:password@host:5432/database

# RapidAPI / Spotify23 catalogue service
RAPIDAPI_KEY=replace-with-your-rapidapi-key
RAPIDAPI_HOST=spotify23.p.rapidapi.com
